{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/expense_tracker_logo.png",

    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.yaswant.expensetracker",

      "adaptiveIcon": {
        "foregroundImage": "./assets/expense_tracker_logo.png",
        "backgroundColor": "#FFFFFF"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/expense_tracker_logo.png"
    },

    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],

    "extra": {
      "eas": {
        "projectId": "13bc03e4-3165-4442-a707-dad70e672f06"
      }
    }
  }
}